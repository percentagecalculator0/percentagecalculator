{
  "name": "percentageincreasecalculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "verify": "npm run test && npm run build && npm run check:links",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "deploy": "npm run test && npm run build:vinext && npx @vinext/cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
