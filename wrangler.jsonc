{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // IMPORTANT: this name must be EXACTLY the name of your Worker/project in the Cloudflare dashboard.
  "name": "percentageincreasecalculator",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // REVIEWS DATABASE: leave this block commented out for the very first deploy.
  // After you create the D1 database (see docs/reviews-setup.md), remove the // from the lines below,
  // put your real database_id, and add a comma after the "observability" block above.
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "pic-reviews", "database_id": "PASTE-YOUR-DATABASE-ID-HERE" }
  // ]
}
